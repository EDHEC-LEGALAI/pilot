{
  "name": "EDHEC Legal AI",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",

  // Make the .env file for the student so all they have to do is paste the key.
  "postCreateCommand": "cp -n .env.example .env || true",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        "editor.wordWrap": "on",
        "files.autoSave": "afterDelay",
        "workbench.startupEditor": "none",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    },
    "codespaces": {
      "openFiles": [
        "START-HERE.md",
        "problems/1-dispute/skill.md"
      ]
    }
  }
}
