# ---------------------------------------------------------------
#  EDHEC Legal AI - environment file
#
#  1. Make a COPY of this file and name the copy   .env
#  2. Paste the API key you were given after API_KEY=
#  3. Save. Do not share the .env file with anyone.
#
#  (.env is listed in .gitignore, so it never leaves your machine.)
# ---------------------------------------------------------------

# The key you were sent by email. Paste it right after the "=" with no spaces.
API_KEY=IFM-...

# The address of the model server. Leave this exactly as it is
# unless you are told otherwise in class.
BASE_URL=https://api.ifm.ai/v1/chat/completions

# The name of the model we are using.
MODEL=IFM/K2-Horizon-375B-A23B
